<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theme; this only needs to be a dark, 
         action-bar-free shell so the window does not flash white on launch. -->
    <style name="Theme.AeroDrop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aerodrop_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
